{
  "name": "bb-plugin-sentry-traces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial bb plugin that sends agent traces to Sentry Agent Monitoring over OTLP.",
  "license": "MIT",
  "author": "Kyle Tryon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleTryon/bb-sentry-traces-plugin-unofficial.git"
  },
  "homepage": "https://github.com/KyleTryon/bb-sentry-traces-plugin-unofficial#readme",
  "bugs": {
    "url": "https://github.com/KyleTryon/bb-sentry-traces-plugin-unofficial/issues"
  },
  "keywords": [
    "bb-plugin",
    "sentry",
    "tracing",
    "otlp",
    "agent-monitoring"
  ],
  "engines": {
    "bb": ">=0.50.0",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Sentry Traces [Unofficial]",
    "description": "Sends agent runs, tool calls, model time and token usage from bb threads to Sentry Agent Monitoring. Off until you add a DSN and turn it on.",
    "branding": {
      "icon": "./assets/sentry-glyph.svg"
    },
    "server": "./src/server.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --type-check --deny-warnings -c .oxlintrc.json .",
    "test": "vitest run --config vitest.config.ts",
    "build": "bb plugin build .",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test",
    "knip": "knip --no-config-hints"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "knip": "^6.48.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "assets",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "knip": {
    "entry": [
      "src/server.ts",
      "tests/**/*.test.ts"
    ],
    "project": [
      "src/**/*.ts",
      "tests/**/*.ts"
    ],
    "ignoreBinaries": [
      "bb"
    ]
  }
}
